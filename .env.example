# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Supabase PostgreSQL connection string
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string
# Use the Transaction pooler URL (port 6543) for Vercel/serverless deployments.
# Use the Direct connection URL (port 5432) for local development or migrations.
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
