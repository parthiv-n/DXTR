# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Supabase PostgreSQL connection string
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string
# Use the Transaction pooler URL (port 6543) for application runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Direct connection for migrations (required for prisma migrate deploy with Supabase)
# Use Session pooler: same host as DATABASE_URL but port 5432 (supports prepared statements)
DIRECT_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"
